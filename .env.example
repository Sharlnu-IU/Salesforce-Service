# Application Settings
APP_ENV=development
LOG_LEVEL=DEBUG

# Database Configuration
DATABASE_URL=postgresql+asyncpg://salesforce:password@localhost:5432/salesforce_master

# Salesforce API Credentials
# NOTE: OAuth 2.0 Client Credentials Flow requires your org-specific My Domain URL.
# Generic 'https://login.salesforce.com' will NOT work with Client Credentials.
# Examples:
#   - Developer Org: https://<my-domain>.develop.my.salesforce.com
#   - Production/Scratch: https://<my-domain>.my.salesforce.com
#   - Sandbox: https://<my-domain>--<sandbox-name>.sandbox.my.salesforce.com
# Find this in Setup -> Company Settings -> My Domain, or copy the base domain from your browser address bar.
SF_LOGIN_URL=https://your-domain.develop.my.salesforce.com
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here
SF_API_VERSION=v60.0

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=salesforce-data
MINIO_SECURE=false

# HMAC Security
HMAC_ENABLED=true
HMAC_SECRET_KEY_CORE=your_core_secret
