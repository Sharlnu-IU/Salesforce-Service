# Application Settings
APP_ENV=development
LOG_LEVEL=DEBUG

# Database Configuration
DATABASE_URL=postgresql+asyncpg://salesforce:password@localhost:5432/salesforce_master

# Salesforce API Credentials
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here
SF_API_VERSION=v60.0

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=salesforce-data
MINIO_SECURE=false

# HMAC Security
HMAC_ENABLED=true
HMAC_SECRET_KEY_CORE=your_core_secret
